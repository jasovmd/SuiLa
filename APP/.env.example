# Copy this file to ".env.local" and fill in the backend's address to use the
# real backend. Leave VITE_API_URL empty (or skip the file) to run on sample data.
# Restart "npm run dev" after changing it.
VITE_API_URL=

# Optional Firebase Auth (Google + phone OTP). Leave empty to use local demo auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# LINE Login (LINE Developers → LINE Login channel).
# Callback must also be registered there:
#   {VITE_API_URL}/auth/line/callback
VITE_LINE_LOGIN_CHANNEL_ID=
VITE_LINE_LOGIN_REDIRECT_URI=
